# Host DAC execution identity (must be a unique, dedicated unprivileged UID:GID on your host)
APP_UID=
APP_GID=

# Component image versions
POSTGRES_VERSION='18-alpine'
SFTPGO_VERSION='latest'

# Host network binding for private WebAdmin access (WireGuard / SSH tunnel)
HOST_BIND_IP='127.0.0.1'
HOST_PORT=54480

# SFTP service configuration (Optional)
# SFTP is disabled by default (0) to eliminate host key requirements.
# When activating SFTP: set SFTP_PORT=2022, define your host's external IP in HOST_IP,
# and choose a random unassigned high port in SFTP_HOST_PORT (avoid predictable ports like 22 or 2022).
SFTP_PORT=0
# HOST_IP=
# SFTP_HOST_PORT=

# ==============================================================================
# HTTP Listener Architecture (Separation of Public WebClient & Private WebAdmin)
# ==============================================================================

# Binding 0: Public WebClient & User REST API (served via Angie reverse proxy)
SFTPGO_HTTPD__BINDINGS__0__PORT=8080
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_ADMIN=false
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_CLIENT=true

# Binding 1: Private WebAdmin & Admin REST API (isolated on localhost / WireGuard)
SFTPGO_HTTPD__BINDINGS__1__PORT=8081
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_ADMIN=true
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_CLIENT=false

# ==============================================================================
# SFTPGo Runtime Tuning (Optional)
# Reference: https://docs.sftpgo.com/2.7/config-file/
# ==============================================================================

# WebDAV service (set to 0 to disable)
# SFTPGO_WEBDAVD__BINDINGS__0__PORT=8090

# Reverse Proxy real IP trust list (Angie gateway IP, Docker bridge gateway, and local loopback)
# Required for CrowdSec and audit logs to record real client IPs from X-Forwarded-For
SFTPGO_HTTPD__BINDINGS__0__PROXY_ALLOWED='172.20.0.254,172.20.0.1,127.0.0.1'
SFTPGO_WEBDAVD__BINDINGS__0__PROXY_ALLOWED='172.20.0.254,172.20.0.1,127.0.0.1'

# Upload mode: 0 (standard direct write with resume), 1 (atomic without resume), 2 (atomic with resume)
# Default in init is 0 (standard) providing clean directories and native upload resume.
# SFTPGO_COMMON__UPLOAD_MODE=0

# Resource exhaustion protection and connection timeouts
# SFTPGO_COMMON__IDLE_TIMEOUT=15
# SFTPGO_COMMON__MAX_TOTAL_CONNECTIONS=100
# SFTPGO_COMMON__MAX_PER_HOST_CONNECTIONS=10

# SFTP hardening: max password attempts before disconnect, and masked banner
# SFTPGO_SFTPD__MAX_AUTH_TRIES=3
# SFTPGO_SFTPD__SERVER_VERSION='SSH-2.0'

# Built-in automatic log rotation (handled directly by SFTPGo inside ./logs)
# SFTPGO_LOG_MAX_SIZE=10
# SFTPGO_LOG_MAX_BACKUPS=5
# SFTPGO_LOG_MAX_AGE=14
# SFTPGO_LOG_COMPRESS=true

# Logging verbosity: debug, info, warn, error
# SFTPGO_LOG_LEVEL='info'

# ==============================================================================
# OpenID Connect (OIDC) / OAuth2 Integration (e.g. Authentik)
# OIDC endpoints and credentials are fully isolated via Docker Secrets:
#   - secrets/sftpgo_oidc_config_url.txt         (Discovery URL in Authentik)
#   - secrets/sftpgo_oidc_client_id.txt          (OAuth2 Client ID)
#   - secrets/sftpgo_oidc_client_secret.txt      (OAuth2 Client Secret)
#   - secrets/sftpgo_oidc_redirect_url.txt       (Optional external redirect base URL)
# ==============================================================================
