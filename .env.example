# SFTPGo Configuration Reference: https://docs.sftpgo.com

APP_UID=
APP_GID=

# POSTGRES_VERSION='18-alpine'
# SFTPGO_VERSION='latest'

# Host network binding for private WebAdmin access (WireGuard / SSH tunnel)
HOST_BIND_IP='127.0.0.1'
HOST_PORT=54480

# Global HTTPD properties (apply to both WebClient and WebAdmin)
# Web root slug: serves web interfaces under /portal/ allowing Angie to lock root (/) with 404
# Note: In SFTPGo, web_root applies to the entire httpd service (both WebClient and WebAdmin).
# In production, change to a custom unguessable path in both .env and Angie sftpgo.conf.
SFTPGO_HTTPD__WEB_ROOT='/portal'

# Binding 0: Public WebClient & User REST API (served via Angie reverse proxy)
SFTPGO_HTTPD__BINDINGS__0__PORT=8080
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_ADMIN=false
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_CLIENT=true
SFTPGO_HTTPD__BINDINGS__0__HIDE_LOGIN_URL=2

SFTPGO_HTTPD__BINDINGS__0__RENDER_OPENAPI=false

# Binding 1: Private WebAdmin & Admin REST API (isolated on localhost / WireGuard)
SFTPGO_HTTPD__BINDINGS__1__PORT=8081
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_ADMIN=true
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_CLIENT=false
SFTPGO_HTTPD__BINDINGS__1__HIDE_LOGIN_URL=1

SFTPGO_HTTPD__BINDINGS__0__PROXY_ALLOWED='172.20.0.254,172.20.0.1,127.0.0.1'
SFTPGO_HTTPD__BINDINGS__0__CLIENT_IP_PROXY_HEADER='X-Forwarded-For'
SFTPGO_HTTPD__BINDINGS__0__CLIENT_IP_HEADER_DEPTH=0

SFTPGO_HTTPD__TOKEN_VALIDATION=2

# De-identification: hide GitHub sponsor links from setup screen
SFTPGO_HTTPD__HIDE_SUPPORT_LINK=true

# WebDAV service (set to 0 to disable)
SFTPGO_WEBDAVD__BINDINGS__0__PORT=8090
# WebDAV URL prefix when proxied behind a subpath (e.g. https://sftp.example/dav/)
# In production, change to a custom unguessable path in both .env and Angie sftpgo.conf.
SFTPGO_WEBDAVD__BINDINGS__0__PREFIX='/dav'

SFTPGO_WEBDAVD__BINDINGS__0__PROXY_ALLOWED='172.20.0.254,172.20.0.1,127.0.0.1'
SFTPGO_WEBDAVD__BINDINGS__0__CLIENT_IP_PROXY_HEADER='X-Forwarded-For'
SFTPGO_WEBDAVD__BINDINGS__0__CLIENT_IP_HEADER_DEPTH=0

# SFTP is disabled by default (0) to eliminate host key requirements.
# When activating SFTP: set SFTPGO_SFTPD__BINDINGS__0__PORT=2022, define your host's external IP in HOST_IP,
# and choose a random unassigned high port in SFTP_HOST_PORT (avoid predictable ports like 22 or 2022).
SFTPGO_SFTPD__BINDINGS__0__PORT=0
# HOST_IP=
# SFTP_HOST_PORT=
# SFTPGO_SFTPD__MAX_AUTH_TRIES=3

# SMTP transport configuration (Optional, credentials are in ./secrets/sftpgo_smtp__*.txt)
# SFTPGO_SMTP__PORT=
# SFTPGO_SMTP__AUTH_TYPE=
# SFTPGO_SMTP__ENCRYPTION=

SFTPGO_COMMON__SERVER_VERSION='short'

SFTPGO_COMMON__UMASK='077'

SFTPGO_DATA_PROVIDER__PASSWORD_VALIDATION__ADMINS__MIN_ENTROPY=200
SFTPGO_DATA_PROVIDER__PASSWORD_VALIDATION__USERS__MIN_ENTROPY=100
SFTPGO_DATA_PROVIDER__PASSWORD_HASHING__ALGO='bcrypt'
SFTPGO_DATA_PROVIDER__PASSWORD_HASHING__BCRYPT_OPTIONS__COST=12

SFTPGO_LOG_LEVEL='info'
SFTPGO_LOG_MAX_SIZE=1
SFTPGO_LOG_MAX_BACKUPS=3
SFTPGO_LOG_MAX_AGE=7
SFTPGO_LOG_COMPRESS=true
